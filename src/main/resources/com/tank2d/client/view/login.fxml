<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStackPane"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.tank2d.client.controller.LoginController"
           stylesheets="@theme.css"
           prefWidth="960.0"
           prefHeight="600.0"
           styleClass="root-pane, auth-root">

    <BorderPane prefWidth="960.0" prefHeight="600.0">
        <center>
            <StackPane alignment="CENTER" styleClass="auth-overlay">

            <!-- ============================================== -->
            <!-- 1. LOGIN FORM CARD                             -->
            <!-- ============================================== -->
            <VBox fx:id="loginForm"
                  alignment="CENTER"
                  spacing="10.0"
                  maxWidth="420.0"
                  prefWidth="420.0"
                  prefHeight="480.0"
                  maxHeight="-Infinity"
                  styleClass="auth-card-login">

                <ImageView fitWidth="135.0"
                           fitHeight="80.0"
                           preserveRatio="true">
                    <image>
                        <Image url="@tank-logo_1.png"/>
                    </image>
                </ImageView>

                <Label text="TANK 2D ONLINE"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 22px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.6), 12, 0.4, 0, 0);"/>

                <Label text="OPERATOR LOGIN"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-font-weight: bold;"/>

                <VBox spacing="12.0" alignment="CENTER" maxWidth="310.0">
                    <TextField fx:id="usernameField"
                               prefHeight="46.0"
                               maxWidth="310.0"
                               promptText="USERNAME"
                               styleClass="auth-field-username"/>

                    <!-- Cụm Mật khẩu Đăng nhập có Mắt xem -->
                    <StackPane alignment="CENTER_RIGHT" maxWidth="310.0">
                        <PasswordField fx:id="passwordField"
                                       prefHeight="46.0"
                                       maxWidth="310.0"
                                       promptText="PASSWORD"
                                       styleClass="auth-field-password"/>

                        <TextField fx:id="passwordTextField"
                                   prefHeight="46.0"
                                   maxWidth="310.0"
                                   promptText="PASSWORD"
                                   styleClass="auth-field-password"
                                   visible="false"
                                   managed="false"/>

                        <Button fx:id="togglePasswordBtn"
                                text="👁"
                                onAction="#togglePasswordVisibility"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 11.5px; -fx-text-fill: #94a3b8; -fx-padding: 0 10px 0 0;"/>
                    </StackPane>
                </VBox>

                <VBox spacing="10.0" alignment="CENTER" maxWidth="310.0">
                    <VBox.margin>
                        <Insets top="8.0"/>
                    </VBox.margin>

                    <Button fx:id="loginButton"
                            text="LOGIN"
                            maxWidth="310.0"
                            prefHeight="48.0"
                            styleClass="btn-primary"
                            onAction="#handleLogin"/>

                    <Button text="REGISTER NOW"
                            maxWidth="310.0"
                            prefHeight="34.0"
                            styleClass="btn-link"
                            onAction="#showRegister"/>
                </VBox>

            </VBox>


            <!-- ============================================== -->
            <!-- 2. REGISTER FORM CARD                          -->
            <!-- ============================================== -->
            <VBox fx:id="registerForm"
                  alignment="CENTER"
                  spacing="9.0"
                  maxWidth="420.0"
                  prefWidth="420.0"
                  prefHeight="530.0"
                  maxHeight="-Infinity"
                  visible="false"
                  managed="false"
                  styleClass="auth-card-register">

                <ImageView fitWidth="120.0"
                           fitHeight="70.0"
                           preserveRatio="true">
                    <image>
                        <Image url="@tank-logo_1.png"/>
                    </image>
                </ImageView>

                <Label text="TANK 2D ONLINE"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 21px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.6), 12, 0.4, 0, 0);"/>

                <Label text="NEW OPERATOR"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-font-weight: bold;"/>

                <VBox spacing="10.0" alignment="CENTER" maxWidth="310.0">
                    <TextField fx:id="registerUsernameField"
                               prefHeight="45.0"
                               maxWidth="310.0"
                               promptText="NEW USERNAME"
                               styleClass="auth-field-username"/>

                    <!-- Mật khẩu đăng ký -->
                    <StackPane alignment="CENTER_RIGHT" maxWidth="310.0">
                        <PasswordField fx:id="registerPasswordField"
                                       prefHeight="45.0"
                                       maxWidth="310.0"
                                       promptText="PASSWORD"
                                       styleClass="auth-field-password"/>

                        <TextField fx:id="registerPasswordTextField"
                                   prefHeight="45.0"
                                   maxWidth="310.0"
                                   promptText="PASSWORD"
                                   styleClass="auth-field-password"
                                   visible="false"
                                   managed="false"/>

                        <Button fx:id="toggleRegisterPasswordBtn"
                                text="👁"
                                onAction="#toggleRegisterPasswordVisibility"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 11.5px; -fx-text-fill: #94a3b8; -fx-padding: 0 10px 0 0;"/>
                    </StackPane>

                    <!-- Xác nhận mật khẩu đăng ký -->
                    <StackPane alignment="CENTER_RIGHT" maxWidth="310.0">
                        <PasswordField fx:id="confirmPasswordField"
                                       prefHeight="45.0"
                                       maxWidth="310.0"
                                       promptText="CONFIRM PASSWORD"
                                       styleClass="auth-field-confirm"/>

                        <TextField fx:id="confirmPasswordTextField"
                                   prefHeight="45.0"
                                   maxWidth="310.0"
                                   promptText="CONFIRM PASSWORD"
                                   styleClass="auth-field-confirm"
                                   visible="false"
                                   managed="false"/>

                        <Button fx:id="toggleConfirmPasswordBtn"
                                text="👁"
                                onAction="#toggleConfirmPasswordVisibility"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 11.5px; -fx-text-fill: #94a3b8; -fx-padding: 0 10px 0 0;"/>
                    </StackPane>
                </VBox>

                <VBox spacing="9.0" alignment="CENTER" maxWidth="310.0">
                    <VBox.margin>
                        <Insets top="8.0"/>
                    </VBox.margin>

                    <Button text="CREATE ACCOUNT"
                            maxWidth="310.0"
                            prefHeight="48.0"
                            styleClass="btn-success"
                            onAction="#handleRegister"/>

                    <Button text="BACK TO LOGIN"
                            maxWidth="310.0"
                            prefHeight="34.0"
                            styleClass="btn-link"
                            onAction="#showLogin"/>
                </VBox>

            </VBox>

        </StackPane>
    </center>
    </BorderPane>

</StackPane>