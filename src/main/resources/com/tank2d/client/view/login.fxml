<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tank2d.client.controller.LoginController"
            prefWidth="800" prefHeight="600" styleClass="auth-root">
    <stylesheets>
        <URL value="@game-theme.css"/>
        <URL value="@theme.css"/>
    </stylesheets>
    <center>
        <StackPane alignment="CENTER" styleClass="auth-stage">
            <!-- Login: all fx:id and onAction declarations match the original controller. -->
            <VBox fx:id="loginForm" alignment="CENTER" spacing="9" maxWidth="420"
                  maxHeight="-Infinity" styleClass="auth-panel">
                <Label text="●  TANK COMMAND  /  MULTIPLAYER" styleClass="auth-kicker"/>
                <ImageView fitWidth="154" fitHeight="91" preserveRatio="true">
                    <image><Image url="@tank-logo_1.png"/></image>
                </ImageView>
                <Label text="TANK 2D ONLINE" styleClass="auth-title"/>
                <Label text="Đăng nhập để tham gia chiến trường" styleClass="auth-hint"/>
                <VBox alignment="CENTER" spacing="11" maxWidth="320">
                    <VBox.margin><Insets top="15"/></VBox.margin>
                    <TextField fx:id="usernameField" prefHeight="43" maxWidth="320"
                               promptText="Tên đăng nhập" styleClass="auth-input"/>
                    <StackPane alignment="CENTER_RIGHT" maxWidth="320">
                        <PasswordField fx:id="passwordField" prefHeight="43" maxWidth="320"
                                       promptText="Mật khẩu" styleClass="auth-input"
                                       style="-fx-padding: 0 42 0 14;"/>
                        <TextField fx:id="passwordTextField" prefHeight="43" maxWidth="320"
                                   promptText="Mật khẩu" styleClass="auth-input"
                                   style="-fx-padding: 0 42 0 14;" visible="false" managed="false"/>
                        <Button fx:id="togglePasswordBtn" text="👁" styleClass="auth-eye"
                                onAction="#togglePasswordVisibility"/>
                    </StackPane>
                </VBox>
                <VBox alignment="CENTER" spacing="10" maxWidth="320">
                    <VBox.margin><Insets top="12"/></VBox.margin>
                    <Button fx:id="loginButton" text="ĐĂNG NHẬP" prefWidth="320" prefHeight="51"
                            styleClass="auth-button-blue" onAction="#handleLogin"/>
                    <Button text="CHƯA CÓ TÀI KHOẢN?  ĐĂNG KÝ" prefWidth="320" prefHeight="51"
                            styleClass="auth-button-yellow" onAction="#showRegister"/>
                </VBox>
                <Label text="READY FOR BATTLE  •  ONLINE MULTIPLAYER" styleClass="auth-footnote">
                    <VBox.margin><Insets top="9"/></VBox.margin>
                </Label>
            </VBox>
            <!-- Registration preserves the original three visibility toggles and methods. -->
            <VBox fx:id="registerForm" alignment="CENTER" spacing="7" maxWidth="420"
                  maxHeight="-Infinity" styleClass="auth-panel" visible="false" managed="false">
                <Label text="●  TANK COMMAND  /  NEW RECRUIT" styleClass="auth-kicker"/>
                <ImageView fitWidth="123" fitHeight="73" preserveRatio="true">
                    <image><Image url="@tank-logo_1.png"/></image>
                </ImageView>
                <Label text="TANK 2D ONLINE" styleClass="auth-title"/>
                <Label text="Tạo tài khoản chiến binh mới" styleClass="auth-hint"/>
                <VBox alignment="CENTER" spacing="9" maxWidth="320">
                    <VBox.margin><Insets top="10"/></VBox.margin>
                    <TextField fx:id="registerUsernameField" prefHeight="40" maxWidth="320"
                               promptText="Tên đăng nhập mới" styleClass="auth-input"/>
                    <StackPane alignment="CENTER_RIGHT" maxWidth="320">
                        <PasswordField fx:id="registerPasswordField" prefHeight="40" maxWidth="320"
                                       promptText="Mật khẩu" styleClass="auth-input"
                                       style="-fx-padding: 0 42 0 14;"/>
                        <TextField fx:id="registerPasswordTextField" prefHeight="40" maxWidth="320"
                                   promptText="Mật khẩu" styleClass="auth-input"
                                   style="-fx-padding: 0 42 0 14;" visible="false" managed="false"/>
                        <Button fx:id="toggleRegisterPasswordBtn" text="👁" styleClass="auth-eye"
                                onAction="#toggleRegisterPasswordVisibility"/>
                    </StackPane>
                    <StackPane alignment="CENTER_RIGHT" maxWidth="320">
                        <PasswordField fx:id="confirmPasswordField" prefHeight="40" maxWidth="320"
                                       promptText="Xác nhận mật khẩu" styleClass="auth-input"
                                       style="-fx-padding: 0 42 0 14;"/>
                        <TextField fx:id="confirmPasswordTextField" prefHeight="40" maxWidth="320"
                                   promptText="Xác nhận mật khẩu" styleClass="auth-input"
                                   style="-fx-padding: 0 42 0 14;" visible="false" managed="false"/>
                        <Button fx:id="toggleConfirmPasswordBtn" text="👁" styleClass="auth-eye"
                                onAction="#toggleConfirmPasswordVisibility"/>
                    </StackPane>
                </VBox>
                <VBox alignment="CENTER" spacing="8" maxWidth="320">
                    <VBox.margin><Insets top="12"/></VBox.margin>
                    <Button text="TẠO TÀI KHOẢN" prefWidth="320" prefHeight="50"
                            styleClass="auth-button-green" onAction="#handleRegister"/>
                    <Button text="←  QUAY LẠI ĐĂNG NHẬP" prefWidth="320" prefHeight="50"
                            styleClass="auth-button-yellow" onAction="#showLogin"/>
                </VBox>
                <Label text="READY FOR BATTLE  •  ONLINE MULTIPLAYER" styleClass="auth-footnote">
                    <VBox.margin><Insets top="6"/></VBox.margin>
                </Label>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
