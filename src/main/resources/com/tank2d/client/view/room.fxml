<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tank2d.client.controller.RoomController"
            stylesheets="@room-theme.css" prefWidth="1000" prefHeight="750"
            styleClass="room-root">
  <top>
    <VBox spacing="0">
      <padding><Insets top="25" left="38" right="38" bottom="16"/></padding>
      <HBox alignment="CENTER_LEFT" spacing="16" styleClass="room-header">
        <ImageView fitWidth="75" fitHeight="55" preserveRatio="true">
          <image><Image url="@tank-logo_1.png"/></image>
        </ImageView>
        <VBox spacing="5" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308">
          <Label fx:id="roomNameLabel" text="Room 01" styleClass="room-name"/>
          <Label fx:id="roomStatusLabel" text="Đang chờ người chơi..."
                 wrapText="true" maxWidth="1.7976931348623157E308"
                 styleClass="room-subtitle"/>
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="6" minWidth="150">
          <Label text="THỜI LƯỢNG TRẬN" styleClass="room-duration-label"/>
          <ComboBox fx:id="durationComboBox" prefWidth="150" minWidth="150"
                    prefHeight="40" styleClass="room-duration-combo"/>
        </VBox>
      </HBox>
    </VBox>
  </top>
  <center>
    <VBox alignment="CENTER" spacing="22">
      <padding><Insets top="8" left="38" right="38" bottom="8"/></padding>
      <Label text="CHỌN VỊ TRÍ CHIẾN ĐẤU  /  CHUẨN BỊ XUẤT PHÁT" styleClass="room-section-title"/>
      <HBox alignment="CENTER" spacing="16">
                <VBox fx:id="slotP1" alignment="CENTER" spacing="11" prefWidth="194" prefHeight="258" styleClass="room-slot-green">
                    <Label text="P1  /  GÓC TRÊN TRÁI" styleClass="room-slot-title-green" />
                    <StackPane minHeight="105" prefHeight="105" maxWidth="151" styleClass="room-tank-pad">
                        <ImageView fitWidth="92" fitHeight="92" preserveRatio="true">
                            <image><Image url="@../assets/images/kenney/tanks/tank_green.png"/></image>
                        </ImageView>
                    </StackPane>
                    <Label fx:id="p1Label" text="Chỗ trống P1" maxWidth="170" alignment="CENTER" styleClass="room-player-name"/>
                    <Label fx:id="p1StatusBadge" text="TRỐNG" styleClass="room-slot-badge"/>
                </VBox>
                <VBox fx:id="slotP2" alignment="CENTER" spacing="11" prefWidth="194" prefHeight="258" styleClass="room-slot-red">
                    <Label text="P2  /  GÓC TRÊN PHẢI" styleClass="room-slot-title-red" />
                    <StackPane minHeight="105" prefHeight="105" maxWidth="151" styleClass="room-tank-pad">
                        <ImageView fitWidth="92" fitHeight="92" preserveRatio="true">
                            <image><Image url="@../assets/images/kenney/tanks/tank_red.png"/></image>
                        </ImageView>
                    </StackPane>
                    <Label fx:id="p2Label" text="Chỗ trống P2" maxWidth="170" alignment="CENTER" styleClass="room-player-name"/>
                    <Label fx:id="p2StatusBadge" text="TRỐNG" styleClass="room-slot-badge"/>
                </VBox>
                <VBox fx:id="slotP3" alignment="CENTER" spacing="11" prefWidth="194" prefHeight="258" styleClass="room-slot-blue">
                    <Label text="P3  /  GÓC DƯỚI TRÁI" styleClass="room-slot-title-blue" />
                    <StackPane minHeight="105" prefHeight="105" maxWidth="151" styleClass="room-tank-pad">
                        <ImageView fitWidth="92" fitHeight="92" preserveRatio="true">
                            <image><Image url="@../assets/images/kenney/tanks/tank_blue.png"/></image>
                        </ImageView>
                    </StackPane>
                    <Label fx:id="p3Label" text="Chỗ trống P3" maxWidth="170" alignment="CENTER" styleClass="room-player-name"/>
                    <Label fx:id="p3StatusBadge" text="TRỐNG" styleClass="room-slot-badge"/>
                </VBox>
                <VBox fx:id="slotP4" alignment="CENTER" spacing="11" prefWidth="194" prefHeight="258" styleClass="room-slot-sand">
                    <Label text="P4  /  GÓC DƯỚI PHẢI" styleClass="room-slot-title-sand" />
                    <StackPane minHeight="105" prefHeight="105" maxWidth="151" styleClass="room-tank-pad">
                        <ImageView fitWidth="92" fitHeight="92" preserveRatio="true">
                            <image><Image url="@../assets/images/kenney/tanks/tank_sand.png"/></image>
                        </ImageView>
                    </StackPane>
                    <Label fx:id="p4Label" text="Chỗ trống P4" maxWidth="170" alignment="CENTER" styleClass="room-player-name"/>
                    <Label fx:id="p4StatusBadge" text="TRỐNG" styleClass="room-slot-badge"/>
                </VBox>
      </HBox>
      <Label text="MULTIPLAYER  •  4 PLAYER SLOTS  •  REAL-TIME COMBAT" styleClass="room-footer-caption"/>
    </VBox>
  </center>
  <bottom>
    <HBox alignment="CENTER" spacing="20">
      <padding><Insets top="9" bottom="32" left="35" right="35"/></padding>
      <Button fx:id="leaveButton" text="←  RỜI PHÒNG" prefWidth="211" prefHeight="68"
              styleClass="room-button-red" onAction="#handleLeave"/>
      <Button fx:id="readyButton" text="SẴN SÀNG" prefWidth="265" prefHeight="68"
              styleClass="room-button-green" onAction="#handleReady"/>
    </HBox>
  </bottom>
</BorderPane>
