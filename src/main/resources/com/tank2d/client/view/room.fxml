<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tank2d.client.controller.RoomController"
            prefWidth="800"
            prefHeight="600">

    <!-- =========================
    TOP
    ========================= -->

    <top>
        <VBox alignment="CENTER"
              spacing="10">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="5"
                        left="20"/>
            </padding>

            <Label fx:id="roomNameLabel"
                   text="ROOM"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

            <Label fx:id="roomStatusLabel"
                   text="Đang chờ người chơi..."
                   style="-fx-font-size: 15px;"/>

            <HBox alignment="CENTER"
                  spacing="10">

                <Label text="Thời lượng:"
                       style="-fx-font-size: 16px;"/>

                <ComboBox fx:id="durationComboBox"
                          prefWidth="130"
                          promptText="Chọn thời gian"/>

            </HBox>

        </VBox>
    </top>


    <!-- =========================
    CENTER
    ========================= -->

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="22">

            <padding>
                <Insets top="20"
                        right="30"
                        bottom="10"
                        left="30"/>
            </padding>

            <Label text="Góc xuất phát"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <HBox alignment="CENTER"
                  spacing="40">

                <!-- P1 -->
                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="120">

                    <Label text="P1"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label fx:id="p1Label"
                           text="Trống"
                           style="-fx-font-size: 15px;"/>

                </VBox>


                <!-- P2 -->
                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="120">

                    <Label text="P2"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label fx:id="p2Label"
                           text="Trống"
                           style="-fx-font-size: 15px;"/>

                </VBox>


                <!-- P3 -->
                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="120">

                    <Label text="P3"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label fx:id="p3Label"
                           text="Trống"
                           style="-fx-font-size: 15px;"/>

                </VBox>


                <!-- P4 -->
                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="120">

                    <Label text="P4"
                           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <Label fx:id="p4Label"
                           text="Trống"
                           style="-fx-font-size: 15px;"/>

                </VBox>

            </HBox>

        </VBox>
    </center>


    <!-- =========================
    BOTTOM
    ========================= -->

    <bottom>
        <HBox alignment="CENTER"
              spacing="25">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="25"
                        left="20"/>
            </padding>

            <Button fx:id="readyButton"
                    text="SẴN SÀNG"
                    prefWidth="170"
                    prefHeight="45"
                    onAction="#handleReady"/>

            <Button fx:id="leaveButton"
                    text="RỜI PHÒNG"
                    prefWidth="170"
                    prefHeight="45"
                    onAction="#handleLeave"/>

        </HBox>
    </bottom>

</BorderPane>