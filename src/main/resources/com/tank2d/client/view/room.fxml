<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tank2d.client.controller.RoomController"
            stylesheets="@theme.css"
            prefWidth="800"
            prefHeight="600">

    <!-- TOP -->
    <top>
        <VBox alignment="CENTER"
              spacing="10">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="5"
                        left="20"/>
            </padding>

            <Label fx:id="roomNameLabel"
                   text="ROOM"
                   style="-fx-text-fill: #2563eb;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;"/>

            <Label fx:id="roomStatusLabel"
                   text="Đang chờ người chơi..."
                   style="-fx-text-fill: #6b7280;
                          -fx-font-size: 15px;"/>

            <HBox alignment="CENTER"
                  spacing="10">

                <Label text="Thời lượng:"
                       style="-fx-text-fill: #374151;
                              -fx-font-size: 16px;
                              -fx-font-weight: bold;"/>

                <ComboBox fx:id="durationComboBox"
                          prefWidth="130"
                          promptText="Chọn thời gian"/>

            </HBox>

        </VBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox alignment="TOP_CENTER"
              spacing="22">

            <padding>
                <Insets top="20"
                        right="30"
                        bottom="10"
                        left="30"/>
            </padding>

            <Label text="Góc xuất phát"
                   style="-fx-text-fill: #1f2937;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;"/>

            <HBox alignment="CENTER"
                  spacing="25">

                <!-- P1 -->
                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="140"
                      prefHeight="110"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #dbe2ea;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                    <Label text="P1"
                           style="-fx-text-fill: #2563eb;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                    <Label fx:id="p1Label"
                           text="Trống"
                           style="-fx-text-fill: #6b7280;
                                  -fx-font-size: 15px;"/>

                </VBox>

                <!-- P2 -->
                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="140"
                      prefHeight="110"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #dbe2ea;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                    <Label text="P2"
                           style="-fx-text-fill: #2563eb;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                    <Label fx:id="p2Label"
                           text="Trống"
                           style="-fx-text-fill: #6b7280;
                                  -fx-font-size: 15px;"/>

                </VBox>

                <!-- P3 -->
                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="140"
                      prefHeight="110"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #dbe2ea;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                    <Label text="P3"
                           style="-fx-text-fill: #2563eb;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                    <Label fx:id="p3Label"
                           text="Trống"
                           style="-fx-text-fill: #6b7280;
                                  -fx-font-size: 15px;"/>

                </VBox>

                <!-- P4 -->
                <VBox alignment="CENTER"
                      spacing="8"
                      prefWidth="140"
                      prefHeight="110"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-border-color: #dbe2ea;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                    <Label text="P4"
                           style="-fx-text-fill: #2563eb;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                    <Label fx:id="p4Label"
                           text="Trống"
                           style="-fx-text-fill: #6b7280;
                                  -fx-font-size: 15px;"/>

                </VBox>

            </HBox>

        </VBox>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox alignment="CENTER"
              spacing="25">

            <padding>
                <Insets top="10"
                        right="20"
                        bottom="25"
                        left="20"/>
            </padding>

            <Button fx:id="readyButton"
                    text="SẴN SÀNG"
                    prefWidth="170"
                    prefHeight="45"
                    styleClass="start-button"
                    onAction="#handleReady"/>

            <Button fx:id="leaveButton"
                    text="RỜI PHÒNG"
                    prefWidth="170"
                    prefHeight="45"
                    styleClass="logout-button"
                    onAction="#handleLeave"/>

        </HBox>
    </bottom>

</BorderPane>