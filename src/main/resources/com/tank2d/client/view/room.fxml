<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tank2d.client.controller.RoomController"
            stylesheets="@lobby.css"
            prefWidth="960.0"
            prefHeight="600.0"
            styleClass="room-root">

    <!-- ============================================== -->
    <!-- TOP: THANH HEADER PHÒNG CHỜ                    -->
    <!-- ============================================== -->
    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets top="14.0" right="24.0" bottom="8.0" left="24.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  style="-fx-background-color: rgba(13, 20, 36, 0.45); -fx-background-radius: 14px; -fx-border-color: rgba(56, 189, 248, 0.35); -fx-border-width: 1.5px; -fx-border-radius: 14px; -fx-padding: 8px 18px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 16, 0.3, 0, 4);">

                <!-- Icon xe tăng + Tên phòng + Trạng thái -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <ImageView fitWidth="48.0" fitHeight="34.0" preserveRatio="true">
                        <image>
                            <Image url="@tank-logo_1.png"/>
                        </image>
                    </ImageView>

                    <VBox spacing="2.0">
                        <Label fx:id="roomNameLabel"
                               text="ROOM #01"
                               style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                        <Label fx:id="roomStatusLabel"
                               text="WAITING FOR OPERATORS..."
                               style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 10.5px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <!-- Cài đặt bản đồ & thời lượng -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Label text="MAP:"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 10.5px; -fx-font-weight: bold;"/>

                    <ComboBox fx:id="mapComboBox"
                              prefWidth="145.0"
                              prefHeight="34.0"
                              styleClass="combo-box"
                              promptText="Select Map"/>

                    <Label text="DURATION:"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 10.5px; -fx-font-weight: bold;"/>

                    <ComboBox fx:id="durationComboBox"
                              prefWidth="90.0"
                              prefHeight="34.0"
                              styleClass="combo-box"
                              promptText="Select"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ============================================== -->
    <!-- CENTER: 4 VỊ TRÍ CHIẾN ĐẤU (P1 - P4)           -->
    <!-- ============================================== -->
    <center>
        <VBox alignment="CENTER" spacing="16.0">
            <padding>
                <Insets top="8.0" right="35.0" bottom="8.0" left="35.0"/>
            </padding>

            <Label text="COMBAT SLOTS &amp; VEHICLE PREVIEW"
                   style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-letter-spacing: 0.5px;"/>

            <!-- 4 Thẻ Slot Player -->
            <HBox alignment="CENTER" spacing="20.0">

                <!-- SLOT P1 (Green Tank) -->
                <VBox fx:id="slotP1"
                      alignment="CENTER"
                      spacing="12.0"
                      prefWidth="205.0"
                      prefHeight="265.0"
                      style="-fx-background-color: rgba(13, 20, 36, 0.42); -fx-background-radius: 14px; -fx-border-color: #22c55e; -fx-border-width: 2px; -fx-border-radius: 14px; -fx-padding: 16px; -fx-effect: dropshadow(gaussian, rgba(34,197,94,0.3), 16, 0.25, 0, 4);">

                    <Label text="P1 • NORTH WEST"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #22c55e; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                    <!-- Mô hình Xe Tăng P1 -->
                    <StackPane prefWidth="110.0" prefHeight="90.0"
                               style="-fx-background-color: rgba(34,197,94,0.12); -fx-background-radius: 12px; -fx-border-color: rgba(34,197,94,0.25); -fx-border-radius: 12px;">
                        <ImageView fitWidth="54.0" fitHeight="54.0" preserveRatio="true" rotate="180.0">
                            <image>
                                <Image url="@../assets/battlefield/tanks/tank_green.png"/>
                            </image>
                        </ImageView>
                    </StackPane>

                    <Label fx:id="p1Label"
                           text="WAITING..."
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-alignment: CENTER;"/>

                    <Label fx:id="p1StatusBadge"
                           text="👑 HOST"
                           style="-fx-background-color: rgba(245, 158, 11, 0.2); -fx-text-fill: #fbbf24; -fx-border-color: #f59e0b; -fx-border-width: 1px; -fx-font-size: 10.5px; -fx-font-weight: bold; -fx-padding: 4px 10px; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif;"/>
                </VBox>

                <!-- SLOT P2 (Red Tank) -->
                <VBox fx:id="slotP2"
                      alignment="CENTER"
                      spacing="12.0"
                      prefWidth="205.0"
                      prefHeight="265.0"
                      style="-fx-background-color: rgba(13, 20, 36, 0.42); -fx-background-radius: 14px; -fx-border-color: #ef4444; -fx-border-width: 1.5px; -fx-border-radius: 14px; -fx-padding: 16px; -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.2), 14, 0.2, 0, 4);">

                    <Label text="P2 • NORTH EAST"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #ef4444; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                    <!-- Mô hình Xe Tăng P2 -->
                    <StackPane prefWidth="110.0" prefHeight="90.0"
                               style="-fx-background-color: rgba(239,68,68,0.12); -fx-background-radius: 12px; -fx-border-color: rgba(239,68,68,0.25); -fx-border-radius: 12px;">
                        <ImageView fitWidth="50.0" fitHeight="54.0" preserveRatio="true" rotate="180.0">
                            <image>
                                <Image url="@../assets/battlefield/tanks/tank_red.png"/>
                            </image>
                        </ImageView>
                    </StackPane>

                    <Label fx:id="p2Label"
                           text="EMPTY"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #64748b; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-alignment: CENTER;"/>

                    <Label fx:id="p2StatusBadge"
                           text="WAITING"
                           style="-fx-background-color: rgba(100, 116, 139, 0.2); -fx-text-fill: #94a3b8; -fx-border-color: #64748b; -fx-border-width: 1px; -fx-font-size: 10.5px; -fx-font-weight: bold; -fx-padding: 4px 10px; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif;"/>
                </VBox>

                <!-- SLOT P3 (Blue Tank) -->
                <VBox fx:id="slotP3"
                      alignment="CENTER"
                      spacing="12.0"
                      prefWidth="205.0"
                      prefHeight="265.0"
                      style="-fx-background-color: rgba(13, 20, 36, 0.42); -fx-background-radius: 14px; -fx-border-color: #3b82f6; -fx-border-width: 1.5px; -fx-border-radius: 14px; -fx-padding: 16px; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.2), 14, 0.2, 0, 4);">

                    <Label text="P3 • SOUTH WEST"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #3b82f6; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                    <!-- Mô hình Xe Tăng P3 -->
                    <StackPane prefWidth="110.0" prefHeight="90.0"
                               style="-fx-background-color: rgba(59,130,246,0.12); -fx-background-radius: 12px; -fx-border-color: rgba(59,130,246,0.25); -fx-border-radius: 12px;">
                        <ImageView fitWidth="54.0" fitHeight="54.0" preserveRatio="true" rotate="180.0">
                            <image>
                                <Image url="@../assets/battlefield/tanks/tank_blue.png"/>
                            </image>
                        </ImageView>
                    </StackPane>

                    <Label fx:id="p3Label"
                           text="EMPTY"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #64748b; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-alignment: CENTER;"/>

                    <Label fx:id="p3StatusBadge"
                           text="WAITING"
                           style="-fx-background-color: rgba(100, 116, 139, 0.2); -fx-text-fill: #94a3b8; -fx-border-color: #64748b; -fx-border-width: 1px; -fx-font-size: 10.5px; -fx-font-weight: bold; -fx-padding: 4px 10px; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif;"/>
                </VBox>

                <!-- SLOT P4 (Sand Tank) -->
                <VBox fx:id="slotP4"
                      alignment="CENTER"
                      spacing="12.0"
                      prefWidth="205.0"
                      prefHeight="265.0"
                      style="-fx-background-color: rgba(13, 20, 36, 0.42); -fx-background-radius: 14px; -fx-border-color: #eab308; -fx-border-width: 1.5px; -fx-border-radius: 14px; -fx-padding: 16px; -fx-effect: dropshadow(gaussian, rgba(234,179,8,0.2), 14, 0.2, 0, 4);">

                    <Label text="P4 • SOUTH EAST"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #eab308; -fx-font-size: 11px; -fx-font-weight: bold;"/>

                    <!-- Mô hình Xe Tăng P4 -->
                    <StackPane prefWidth="110.0" prefHeight="90.0"
                               style="-fx-background-color: rgba(234,179,8,0.12); -fx-background-radius: 12px; -fx-border-color: rgba(234,179,8,0.25); -fx-border-radius: 12px;">
                        <ImageView fitWidth="54.0" fitHeight="54.0" preserveRatio="true" rotate="180.0">
                            <image>
                                <Image url="@../assets/battlefield/tanks/tank_sand.png"/>
                            </image>
                        </ImageView>
                    </StackPane>

                    <Label fx:id="p4Label"
                           text="EMPTY"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #64748b; -fx-font-size: 12.5px; -fx-font-weight: bold; -fx-alignment: CENTER;"/>

                    <Label fx:id="p4StatusBadge"
                           text="WAITING"
                           style="-fx-background-color: rgba(100, 116, 139, 0.2); -fx-text-fill: #94a3b8; -fx-border-color: #64748b; -fx-border-width: 1px; -fx-font-size: 10.5px; -fx-font-weight: bold; -fx-padding: 4px 10px; -fx-background-radius: 12px; -fx-border-radius: 12px; -fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif;"/>
                </VBox>

            </HBox>
        </VBox>
    </center>

    <!-- ============================================== -->
    <!-- BOTTOM: CÁC NÚT ĐIỀU KHIỂN PHÒNG CHỜ           -->
    <!-- ============================================== -->
    <bottom>
        <HBox alignment="CENTER" spacing="28.0">
            <padding>
                <Insets top="10.0" right="35.0" bottom="24.0" left="35.0"/>
            </padding>

            <Button fx:id="leaveButton"
                    text="← LEAVE ROOM"
                    prefWidth="200.0"
                    prefHeight="46.0"
                    styleClass="btn-danger"
                    onAction="#handleLeave"/>

            <Button fx:id="readyButton"
                    text="READY"
                    prefWidth="240.0"
                    prefHeight="46.0"
                    styleClass="btn-success"
                    onAction="#handleReady"/>
        </HBox>
    </bottom>

</BorderPane>