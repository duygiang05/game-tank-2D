<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.tank2d.client.controller.LobbyController"
           stylesheets="@lobby.css" fx:id="rootStackPane"
           prefWidth="1000" prefHeight="750" styleClass="lobby-root">
  <BorderPane fx:id="mainContentPane" styleClass="lobby-main">
    <top><VBox><padding><Insets top="16" right="28" bottom="10" left="28"/></padding>
      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar-card">
        <ImageView fitWidth="76" fitHeight="50" preserveRatio="true">
          <image><Image url="@tank-logo_1.png"/></image>
        </ImageView>
        <VBox alignment="CENTER_LEFT" spacing="3">
          <Label text="TANK 2D ONLINE" styleClass="lobby-title"/>
          <Label text="MULTIPLAYER  /  LOBBY COMMAND" styleClass="lobby-kicker"/>
        </VBox>
        <HBox HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT" spacing="3">
          <Label text="CHIẾN BINH ĐANG TRỰC TUYẾN" styleClass="lobby-kicker"/>
          <Label fx:id="usernameLabel" text="Player" styleClass="lobby-player"/>
        </VBox>
        <Button fx:id="logoutButton" text="ĐĂNG XUẤT" prefWidth="146" prefHeight="49"
                styleClass="kenney-red" onAction="#handleLogout"/>
      </HBox>
    </VBox></top>
    <center><VBox spacing="11">
      <padding><Insets top="2" right="28" bottom="8" left="28"/></padding>
      <VBox styleClass="lobby-table-card" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="lobby-toolbar">
          <VBox spacing="3"><Label text="DANH SÁCH PHÒNG CHỜ" styleClass="lobby-heading"/>
            <Label text="CHỌN PHÒNG ĐỂ THAM GIA CHIẾN ĐẤU" styleClass="lobby-kicker"/>
          </VBox>
          <HBox HBox.hgrow="ALWAYS"/>
          <Label text="Thời gian trận:" styleClass="lobby-filter-caption"/>
          <ComboBox fx:id="durationFilterComboBox" prefWidth="135" prefHeight="37" styleClass="lobby-filter"/>
        </HBox>
        <VBox VBox.vgrow="ALWAYS" styleClass="lobby-list-shell">
          <HBox alignment="CENTER_LEFT" styleClass="table-header">
            <Label text="TÊN PHÒNG" prefWidth="260" styleClass="table-header-label"/>
            <Label text="SỐ NGƯỜI" prefWidth="110" alignment="CENTER" styleClass="table-header-label"/>
            <Label text="THỜI LƯỢNG" prefWidth="120" alignment="CENTER" styleClass="table-header-label"/>
            <Label text="TRẠNG THÁI" prefWidth="140" alignment="CENTER_RIGHT" styleClass="table-header-label"/>
          </HBox>
          <ListView fx:id="roomListView" VBox.vgrow="ALWAYS" prefHeight="300" styleClass="lobby-room-list"/>
        </VBox>
      </VBox>
      <Label fx:id="statusLabel" text="Đang tải danh sách phòng..." styleClass="lobby-status"/>
    </VBox></center>
    <bottom><HBox alignment="CENTER" spacing="11">
      <padding><Insets top="8" right="28" bottom="20" left="28"/></padding>
      <Button fx:id="leaderboardButton" text="BẢNG XẾP HẠNG" prefWidth="205" prefHeight="65"
              styleClass="kenney-yellow" onAction="#handleLeaderboard"/>
      <Button fx:id="matchHistoryButton" text="LỊCH SỬ ĐẤU" prefWidth="192" prefHeight="65"
              styleClass="kenney-blue" onAction="#handleMatchHistory"/>
      <HBox HBox.hgrow="ALWAYS"/>
      <Button fx:id="createRoomButton" text="+ TẠO PHÒNG" prefWidth="192" prefHeight="65"
              styleClass="kenney-blue" onAction="#handleCreateRoom"/>
      <Button fx:id="joinRoomButton" text="VÀO PHÒNG  ➜" prefWidth="192" prefHeight="65"
              styleClass="kenney-green" onAction="#handleJoinRoom"/>
    </HBox></bottom>
  </BorderPane>
  <StackPane fx:id="penaltyOverlay" visible="false" styleClass="lobby-overlay">
    <VBox alignment="CENTER" spacing="14" maxWidth="500" maxHeight="340" styleClass="lobby-dialog">
      <Label text="⛔" styleClass="dialog-icon"/>
      <Label text="TÀI KHOẢN ĐANG BỊ PHẠT" styleClass="dialog-warning-title"/>
      <Label text="Bạn bị phạt do thoát trận giữa chừng!" styleClass="dialog-heading"/>
      <Label text="Vui lòng đợi đến khi trận đấu hiện tại kết thúc để tiếp tục tham gia hoặc tạo phòng mới."
             wrapText="true" textAlignment="CENTER" styleClass="dialog-description"/>
      <Button text="ĐĂNG XUẤT TÀI KHOẢN" prefWidth="260" prefHeight="62"
              styleClass="kenney-red" onAction="#handleLogout"/>
    </VBox>
  </StackPane>
  <StackPane fx:id="reconnectOverlay" visible="false" styleClass="lobby-overlay">
    <VBox alignment="CENTER" spacing="12" maxWidth="535" maxHeight="375" styleClass="lobby-dialog">
      <Label text="⚔" styleClass="dialog-icon"/>
      <Label text="PHÁT HIỆN TRẬN ĐẤU DỞ DANG" styleClass="dialog-accent-title"/>
      <Label fx:id="reconnectRoomLabel" text="Phòng đấu: Room #01" styleClass="dialog-heading"/>
      <Label fx:id="reconnectTimeLabel" text="Thời gian còn lại: 02:15" styleClass="dialog-accent-title"/>
      <Label text="Xe tăng của bạn đang chờ trên bản đồ. Hãy vào lại để tiếp tục chiến đấu cùng mọi người!"
             wrapText="true" textAlignment="CENTER" styleClass="dialog-description"/>
      <HBox alignment="CENTER" spacing="11">
        <Button fx:id="skipReconnectButton" text="BỎ QUA" prefWidth="184" prefHeight="62"
                styleClass="kenney-yellow" onAction="#handleSkipReconnect"/>
        <Button fx:id="confirmReconnectButton" text="VÀO LẠI TRẬN" prefWidth="205" prefHeight="65"
                styleClass="kenney-green" onAction="#handleConfirmReconnect"/>
      </HBox>
    </VBox>
  </StackPane>
</StackPane>
