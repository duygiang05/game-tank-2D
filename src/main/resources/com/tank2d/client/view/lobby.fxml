<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tank2d.client.controller.LobbyController"
            stylesheets="@lobby.css, @theme.css"
            prefWidth="800.0"
            prefHeight="600.0">

    <!-- ========================= -->
    <!-- HEADER -->
    <!-- ========================= -->

    <top>
        <VBox alignment="CENTER"
              spacing="6.0">

            <padding>
                <Insets top="12.0" bottom="8.0"/>
            </padding>

            <ImageView fitWidth="105.0"
                       fitHeight="65.0"
                       preserveRatio="true">
                <image>
                    <Image url="@tank-logo_1.png"/>
                </image>
            </ImageView>

            <Label text="TANK 2D ONLINE"
                   style="-fx-text-fill: #2563eb;
                          -fx-font-size: 26px;
                          -fx-font-weight: bold;"/>

            <Label text="LOBBY - DANH SÁCH PHÒNG"
                   style="-fx-text-fill: #374151;
                          -fx-font-size: 17px;
                          -fx-font-weight: bold;"/>

            <Label fx:id="usernameLabel"
                   text="Xin chào"
                   style="-fx-text-fill: #2563eb;
                          -fx-font-size: 15px;
                          -fx-font-weight: bold;"/>

        </VBox>
    </top>


    <!-- ========================= -->
    <!-- DANH SÁCH PHÒNG -->
    <!-- ========================= -->

    <center>

        <VBox spacing="10.0">

            <padding>
                <Insets top="5.0"
                        right="40.0"
                        bottom="5.0"
                        left="40.0"/>
            </padding>

            <!-- Thanh tiêu đề -->
            <HBox alignment="CENTER_LEFT"
                  spacing="15.0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: #dbe2ea;
                         -fx-border-radius: 10;
                         -fx-padding: 12;">

                <Label text="DANH SÁCH PHÒNG"
                       style="-fx-text-fill: #1f2937;
                              -fx-font-size: 18px;
                              -fx-font-weight: bold;"/>

                <HBox alignment="CENTER_RIGHT"
                      spacing="8.0"
                      HBox.hgrow="ALWAYS">

                    <Label text="Thời gian:"
                           style="-fx-text-fill: #6b7280;
                                  -fx-font-size: 14px;"/>

                    <ComboBox fx:id="durationFilterComboBox"
                              prefWidth="120.0"
                              promptText="Tất cả"/>

                </HBox>

            </HBox>


            <!-- Danh sách phòng -->

            <ListView fx:id="roomListView"
                      prefHeight="270.0"
                      style="-fx-background-color: white;
                             -fx-background-radius: 10;
                             -fx-border-color: #dbe2ea;
                             -fx-border-radius: 10;"/>


            <!-- Trạng thái -->

            <Label fx:id="statusLabel"
                   text="Vui lòng chọn một phòng"
                   style="-fx-text-fill: #6b7280;
                          -fx-font-size: 13px;"/>

        </VBox>

    </center>


    <!-- ========================= -->
    <!-- CÁC NÚT -->
    <!-- ========================= -->

    <bottom>

        <VBox alignment="CENTER"
              spacing="8.0">

            <padding>
                <Insets top="8.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>


            <!-- Tạo / Vào phòng -->

            <HBox alignment="CENTER"
                  spacing="15.0">

                <Button fx:id="createRoomButton"
                        text="+  Tạo phòng"
                        prefWidth="190.0"
                        prefHeight="40.0"
                        styleClass="start-button"
                        onAction="#handleCreateRoom"/>

                <Button fx:id="joinRoomButton"
                        text="Vào phòng"
                        prefWidth="190.0"
                        prefHeight="40.0"
                        onAction="#handleJoinRoom"/>

            </HBox>


            <!-- Leaderboard / Logout -->

            <HBox alignment="CENTER"
                  spacing="15.0">

                <Button fx:id="leaderboardButton"
                        text="🏆  Bảng xếp hạng"
                        prefWidth="190.0"
                        prefHeight="38.0"
                        styleClass="secondary-button"
                        onAction="#handleLeaderboard"/>

                <Button fx:id="logoutButton"
                        text="Đăng xuất"
                        prefWidth="190.0"
                        prefHeight="38.0"
                        styleClass="logout-button"
                        onAction="#handleLogout"/>

            </HBox>

        </VBox>

    </bottom>

</BorderPane>