<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="rootStackPane"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.tank2d.client.controller.LobbyController"
           stylesheets="@lobby.css"
           styleClass="lobby-root"
           prefWidth="960.0"
           prefHeight="600.0">

    <!-- ============================================== -->
    <!-- LỚP 1: GIAO DIỆN CHÍNH SẢNH (MAIN CONTENT)     -->
    <!-- ============================================== -->
    <BorderPane fx:id="mainContentPane"
                prefWidth="960.0"
                prefHeight="600.0"
                styleClass="lobby-main-pane">

        <!-- TOP: THANH THÔNG TIN NGƯỜI CHƠI & LOGO -->
        <top>
            <VBox spacing="8.0">
                <padding>
                    <Insets top="14.0" right="35.0" bottom="6.0" left="35.0"/>
                </padding>

                <HBox alignment="CENTER_LEFT" styleClass="top-bar-card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitWidth="50.0" fitHeight="34.0" preserveRatio="true">
                            <image>
                                <Image url="@tank-logo_1.png"/>
                            </image>
                        </ImageView>
                        <Label text="TANK 2D ONLINE"
                                style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 18px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.5), 10, 0.3, 0, 0);"/>
                    </HBox>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <HBox fx:id="playerBadgeBox" alignment="CENTER" spacing="6.0" styleClass="player-badge"
                              onMouseClicked="#handleViewProfile">
                            <Label text="👤" style="-fx-font-size: 13px;"/>
                            <Label fx:id="usernameLabel" text="PLAYER"
                                   style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 12.5px; -fx-font-weight: bold;"/>
                            <Label text="ℹ" style="-fx-text-fill: #38bdf8; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                        </HBox>

                        <Button fx:id="lobbySettingsButton"
                                text="⚙"
                                prefWidth="40.0"
                                prefHeight="34.0"
                                styleClass="btn-setting"
                                onAction="#handleOpenSettings"/>

                        <Button fx:id="logoutButton"
                                text="LOGOUT"
                                prefWidth="105.0"
                                prefHeight="34.0"
                                styleClass="btn-logout"
                                onAction="#handleLogout"/>
                    </HBox>
                </HBox>
            </VBox>
        </top>

        <!-- CENTER: BẢNG DANH SÁCH PHÒNG & DANH SÁCH NGƯỜI CHƠI ONLINE -->
        <center>
            <VBox spacing="8.0">
                <padding>
                    <Insets top="4.0" right="35.0" bottom="8.0" left="35.0"/>
                </padding>

                <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                    <!-- TRÁI: BẢNG DANH SÁCH PHÒNG -->
                    <VBox styleClass="lobby-table-card" HBox.hgrow="ALWAYS">
                        <!-- Thanh công cụ: Tiêu đề sảnh & Bộ lọc -->
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 10px 16px; -fx-border-color: rgba(56, 189, 248, 0.25); -fx-border-width: 0 0 1px 0;">
                            <Label text="BATTLE LOBBY ROOMS"
                                   style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 14px; -fx-font-weight: bold;"/>

                            <HBox HBox.hgrow="ALWAYS"/>

                            <HBox alignment="CENTER_RIGHT" spacing="6.0">
                                <Label text="DURATION:" style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <ComboBox fx:id="durationFilterComboBox"
                                          prefWidth="105.0"
                                          prefHeight="30.0"/>
                            </HBox>
                        </HBox>

                        <!-- Thanh Header chia cột: Room 290, Players 95, Duration 90, Status 130 -->
                        <HBox alignment="CENTER_LEFT" styleClass="table-header">
                            <Label text="ROOM NAME" prefWidth="290.0" HBox.hgrow="ALWAYS" styleClass="table-header-label"/>
                            <Label text="PLAYERS" prefWidth="95.0" alignment="CENTER" styleClass="table-header-label"/>
                            <Label text="DURATION" prefWidth="90.0" alignment="CENTER" styleClass="table-header-label"/>
                            <Label text="STATUS" prefWidth="130.0" alignment="CENTER_RIGHT" styleClass="table-header-label"/>
                        </HBox>

                        <!-- ListView chứa các dòng phòng -->
                        <ListView fx:id="roomListView" VBox.vgrow="ALWAYS" prefHeight="260.0"/>
                    </VBox>

                    <!-- PHẢI: BẢNG NGƯỜI CHƠI ONLINE (THU GỌN LẠI ĐỂ TĂNG KHÔNG GIAN BẢNG PHÒNG) -->
                    <VBox styleClass="lobby-table-card" prefWidth="235.0" minWidth="220.0" maxWidth="245.0">
                        <!-- Thanh công cụ người chơi online -->
                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 10px 12px; -fx-border-color: rgba(56, 189, 248, 0.25); -fx-border-width: 0 0 1px 0;">
                            <Label text="ONLINE"
                                   style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 13px; -fx-font-weight: bold;"/>

                            <HBox HBox.hgrow="ALWAYS"/>

                            <Label fx:id="onlineCountBadge" text="0 ON"
                                   style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #4ade80; -fx-font-size: 10px; -fx-font-weight: bold; -fx-background-color: rgba(34, 197, 94, 0.15); -fx-padding: 2px 6px; -fx-background-radius: 9px; -fx-border-color: rgba(74, 222, 128, 0.4); -fx-border-radius: 9px;"/>
                        </HBox>

                        <!-- Header Cột Online: Operator + Action -->
                        <HBox alignment="CENTER_LEFT" styleClass="table-header">
                            <Label text="OPERATOR" prefWidth="135.0" HBox.hgrow="ALWAYS" styleClass="table-header-label"/>
                            <Label text="ACTION" prefWidth="70.0" alignment="CENTER_RIGHT" styleClass="table-header-label"/>
                        </HBox>

                        <!-- ListView chứa danh sách người chơi online -->
                        <ListView fx:id="onlinePlayersListView" VBox.vgrow="ALWAYS" prefHeight="260.0"/>
                    </VBox>
                </HBox>

                <Label fx:id="statusLabel"
                       text="LOADING ROOMS..."
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 11.5px; -fx-padding: 0 4px;"/>
            </VBox>
        </center>

        <!-- BOTTOM: CÁC NÚT ĐIỀU KHIỂN -->
        <bottom>
            <HBox alignment="CENTER" spacing="14.0">
                <padding>
                    <Insets top="4.0" right="35.0" bottom="18.0" left="35.0"/>
                </padding>

                <Button fx:id="leaderboardButton"
                        text="🏆 RANKINGS"
                        prefWidth="160.0"
                        prefHeight="46.0"
                        styleClass="btn-leaderboard"
                        onAction="#handleLeaderboard"/>

                <Button fx:id="matchHistoryButton"
                        text="📜 HISTORY"
                        prefWidth="150.0"
                        prefHeight="46.0"
                        styleClass="btn-match-history"
                        onAction="#handleMatchHistory"/>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button fx:id="createRoomButton"
                        text="+ CREATE ROOM"
                        prefWidth="175.0"
                        prefHeight="46.0"
                        styleClass="btn-create-room"
                        onAction="#handleCreateRoom"/>

                <Button fx:id="joinRoomButton"
                        text="JOIN ROOM ➜"
                        prefWidth="175.0"
                        prefHeight="46.0"
                        styleClass="btn-join-room"
                        onAction="#handleJoinRoom"/>
            </HBox>
        </bottom>
    </BorderPane>

    <!-- ============================================== -->
    <!-- LỚP 2: OVERLAY HÌNH PHẠT THOÁT TRẬN            -->
    <!-- ============================================== -->
    <StackPane fx:id="penaltyOverlay" visible="false"
               style="-fx-background-color: rgba(10, 15, 29, 0.88);">
        <VBox alignment="CENTER" spacing="18.0" maxWidth="480.0" maxHeight="330.0"
              style="-fx-background-color: rgba(13, 20, 36, 0.95); -fx-background-radius: 20px; -fx-padding: 32px 36px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 30, 0.35, 0, 10); -fx-border-color: rgba(239, 68, 68, 0.6); -fx-border-width: 2px; -fx-border-radius: 20px;">
            
            <StackPane prefWidth="64.0" prefHeight="64.0">
                <Circle radius="32.0" fill="#450a0a" stroke="#ef4444" strokeWidth="1.5"/>
                <SVGPath content="M 12 2 C 6.48 2 2 6.48 2 12 s 4.48 10 10 10 s 10 -4.48 10 -10 S 17.52 2 12 2 z M 4 12 c 0 -4.42 3.58 -8 8 -8 c 1.85 0 3.55 0.63 4.9 1.69 L 5.69 16.9 C 4.63 15.55 4 13.85 4 12 z M 12 20 c -1.85 0 -3.55 -0.63 -4.9 -1.69 L 18.31 7.1 C 19.37 8.45 20 10.15 20 12 c 0 4.42 -3.58 8 -8 8 z"
                         fill="#ef4444" scaleX="1.3" scaleY="1.3"/>
            </StackPane>

            <VBox alignment="CENTER" spacing="8.0">
                <Label text="ACCOUNT PENALIZED"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #ef4444; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="YOU WERE PENALIZED FOR ABANDONING A MATCH!"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #f8fafc; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <Label text="Please wait until the current battle concludes before joining or creating new rooms."
                       wrapText="true" textAlignment="CENTER"
                       style="-fx-font-family: 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 12.5px; -fx-line-spacing: 2px;"/>
            </VBox>

            <Button text="LOGOUT"
                    prefWidth="180.0" prefHeight="42.0"
                    styleClass="btn-logout"
                    onAction="#handleLogout"/>
        </VBox>
    </StackPane>

    <!-- ============================================== -->
    <!-- LỚP 3: OVERLAY RECONNECT (TRẬN ĐẤU DỞ DANG)    -->
    <!-- ============================================== -->
    <StackPane fx:id="reconnectOverlay" visible="false"
               style="-fx-background-color: rgba(10, 15, 29, 0.85);">
        <VBox alignment="CENTER" spacing="18.0" maxWidth="500.0" maxHeight="350.0"
              style="-fx-background-color: rgba(13, 20, 36, 0.95); -fx-background-radius: 20px; -fx-padding: 30px 36px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 30, 0.35, 0, 10); -fx-border-color: rgba(249, 115, 22, 0.6); -fx-border-width: 2px; -fx-border-radius: 20px;">
            
            <StackPane prefWidth="64.0" prefHeight="64.0">
                <Circle radius="32.0" fill="#431407" stroke="#f97316" strokeWidth="1.5"/>
                <SVGPath content="M 2.47 19.03 l 2.5 2.5 c 0.59 0.59 1.54 0.59 2.12 0 l 2.47 -2.47 l 1.41 1.41 l 1.41 -1.41 l -1.41 -1.41 l 6.94 -6.94 l 2.83 2.83 l 1.41 -1.41 l -2.83 -2.83 l 4.24 -4.24 c 0.59 -0.59 0.59 -1.54 0 -2.12 l -2.5 -2.5 c -0.59 -0.59 -1.54 -0.59 -2.12 0 l -4.24 4.24 l -2.83 -2.83 l -1.41 1.41 l 2.83 2.83 l -6.94 6.94 l -1.41 -1.41 l -1.41 1.41 l 1.41 1.41 l -2.47 2.47 c -0.58 0.59 -0.58 1.54 0 2.12 z M 21.53 19.03 l -2.5 2.5 c -0.59 0.59 -1.54 0.59 -2.12 0 l -2.47 -2.47 l -1.41 1.41 l -1.41 -1.41 l 1.41 -1.41 l -6.94 -6.94 l -2.83 2.83 l -1.41 -1.41 l 2.83 -2.83 l -4.24 -4.24 c -0.59 -0.59 -0.59 -1.54 0 -2.12 l 2.5 -2.5 c 0.59 -0.59 1.54 -0.59 2.12 0 l 4.24 4.24 l 2.83 -2.83 l 1.41 1.41 l -2.83 2.83 l 6.94 6.94 l 1.41 -1.41 l 1.41 1.41 l -1.41 1.41 l 2.47 2.47 c 0.58 0.59 0.58 1.54 0 2.12 z"
                         fill="#f97316" scaleX="1.25" scaleY="1.25"/>
            </StackPane>

            <VBox alignment="CENTER" spacing="8.0">
                <Label text="MATCH IN PROGRESS DETECTED"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #f97316; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                <Label fx:id="reconnectRoomLabel" text="ROOM #01"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #f8fafc; -fx-font-size: 14.5px; -fx-font-weight: bold;"/>
                <Label fx:id="reconnectTimeLabel" text="REMAINING: 02:15"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 13.5px; -fx-font-weight: bold;"/>
                <Label text="Your tank is waiting on the battlefield. Reconnect now to continue fighting!"
                       wrapText="true" textAlignment="CENTER"
                       style="-fx-font-family: 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 12.5px; -fx-line-spacing: 2px;"/>
            </VBox>

            <HBox alignment="CENTER" spacing="14.0">
                <Button fx:id="skipReconnectButton" text="SKIP"
                        prefWidth="130.0" prefHeight="42.0"
                        styleClass="btn-logout"
                        onAction="#handleSkipReconnect"/>

                <Button fx:id="confirmReconnectButton" text="RECONNECT ➜"
                        prefWidth="200.0" prefHeight="42.0"
                        styleClass="btn-create-room"
                        onAction="#handleConfirmReconnect"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- ============================================== -->
    <!-- LỚP 4: OVERLAY THÁCH ĐẤU (BATTLE CHALLENGE)     -->
    <!-- ============================================== -->
    <StackPane fx:id="inviteOverlay" visible="false"
               style="-fx-background-color: rgba(10, 15, 29, 0.85);">
        <VBox alignment="CENTER" spacing="18.0" maxWidth="480.0" maxHeight="320.0"
              style="-fx-background-color: rgba(13, 20, 36, 0.95); -fx-background-radius: 20px; -fx-padding: 28px 32px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 30, 0.35, 0, 10); -fx-border-color: rgba(56, 189, 248, 0.6); -fx-border-width: 2px; -fx-border-radius: 20px;">
            
            <StackPane prefWidth="64.0" prefHeight="64.0">
                <Circle radius="32.0" fill="#082f49" stroke="#38bdf8" strokeWidth="1.5"/>
                <ImageView fitWidth="42.0" fitHeight="42.0" preserveRatio="true">
                    <image>
                        <Image url="@tank-logo_1.png"/>
                    </image>
                </ImageView>
            </StackPane>

            <VBox alignment="CENTER" spacing="8.0">
                <Label text="BATTLE CHALLENGE!"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="inviteMessageLabel" text="OPERATOR CHALLENGES YOU TO A DUEL!"
                       wrapText="true" textAlignment="CENTER"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #f8fafc; -fx-font-size: 12.5px; -fx-font-weight: bold;"/>
                <Label text="Accepting will immediately create a battlefield room and transport both players."
                       wrapText="true" textAlignment="CENTER"
                       style="-fx-font-family: 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            </VBox>

            <HBox alignment="CENTER" spacing="16.0">
                <Button text="DECLINE"
                        prefWidth="130.0" prefHeight="42.0"
                        styleClass="btn-logout"
                        onAction="#handleDeclineInvite"/>

                <Button text="ACCEPT ➜"
                        prefWidth="160.0" prefHeight="42.0"
                        styleClass="btn-create-room"
                        onAction="#handleAcceptInvite"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>