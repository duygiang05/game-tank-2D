<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStackPane"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.tank2d.client.controller.MatchHistoryController"
           stylesheets="@lobby.css"
           styleClass="history-root"
           prefWidth="960.0"
           prefHeight="600.0">

    <!-- ============================================== -->
    <!-- LỚP 1: GIAO DIỆN CHÍNH (MAIN CONTENT PANE)      -->
    <!-- ============================================== -->
    <BorderPane fx:id="mainContentPane"
                prefWidth="960.0"
                prefHeight="600.0"
                styleClass="lobby-main-pane">

        <!-- TOP: LOGO & TIÊU ĐỀ LỊCH SỬ ĐẤU -->
        <top>
            <VBox alignment="CENTER" spacing="3.0">
                <padding>
                    <Insets top="14.0" bottom="6.0"/>
                </padding>

                <ImageView fitWidth="50.0" fitHeight="34.0" preserveRatio="true">
                    <image>
                        <Image url="@tank-logo_1.png"/>
                    </image>
                </ImageView>

                <Label text="TANK 2D ONLINE"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 18px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.5), 10, 0.3, 0, 0);"/>

                <Label text="📜 BATTLE LOG &amp; RECORDS"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #fbbf24; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            </VBox>
        </top>

        <!-- CENTER: BẢNG LỊCH SỬ ĐẤU THIẾT KẾ HIỆN ĐẠI -->
        <center>
            <VBox spacing="6.0">
                <padding>
                    <Insets top="2.0" right="45.0" bottom="4.0" left="45.0"/>
                </padding>

                <VBox style="-fx-background-color: rgba(13, 20, 36, 0.42); -fx-background-radius: 14px; -fx-border-color: rgba(56, 189, 248, 0.4); -fx-border-width: 2px; -fx-border-radius: 14px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.65), 22, 0.35, 0, 6);"
                      VBox.vgrow="ALWAYS">

                    <!-- Header chia 5 cột gọn gàng: 125 + 260 + 140 + 100 + 100 = 725px -->
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-background-color: rgba(15, 23, 42, 0.50); -fx-padding: 10px 18px; -fx-background-radius: 12px 12px 0 0; -fx-border-color: rgba(56, 189, 248, 0.25); -fx-border-width: 0 0 1.5px 0;">

                        <Label text="RESULT / RANK" prefWidth="125.0" alignment="CENTER_LEFT"
                               style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>

                        <Label text="ROOM" prefWidth="260.0" alignment="CENTER_LEFT"
                               style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>

                        <Label text="TIMESTAMP" prefWidth="140.0" alignment="CENTER_LEFT"
                               style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>

                        <Label text="KILLS / HITS" prefWidth="100.0" alignment="CENTER_RIGHT"
                               style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>

                        <Label text="POINTS" prefWidth="100.0" alignment="CENTER_RIGHT"
                               style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                    </HBox>

                    <!-- ListView chứa danh sách trận đấu -->
                    <ListView fx:id="matchHistoryListView"
                              VBox.vgrow="ALWAYS"
                              prefHeight="310.0"
                              style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 4px;"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="statusLabel"
                           text="LOADING BATTLE LOGS..."
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-padding: 0 4px;"/>
                    <HBox HBox.hgrow="ALWAYS"/>
                    <Label text="💡 Click any battle row to view operator details"
                           style="-fx-font-family: 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 11.5px; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </center>

        <!-- BOTTOM: NÚT QUAY LẠI LOBBY -->
        <bottom>
            <HBox alignment="CENTER">
                <padding>
                    <Insets top="4.0" bottom="18.0"/>
                </padding>

                <Button fx:id="backButton"
                        text="← BACK TO LOBBY"
                        prefWidth="220.0"
                        prefHeight="44.0"
                        styleClass="btn-primary"
                        onAction="#handleBack"/>
            </HBox>
        </bottom>
    </BorderPane>

    <!-- ============================================== -->
    <!-- LỚP 2: POPUP OVERLAY CHI TIẾT TRẬN ĐẤU         -->
    <!-- Mờ nền xung quanh, click ra ngoài để đóng      -->
    <!-- ============================================== -->
    <StackPane fx:id="detailOverlay" visible="false"
               style="-fx-background-color: rgba(6, 10, 20, 0.48);"
               onMouseClicked="#handleOverlayClicked">

        <VBox fx:id="detailCard" alignment="TOP_CENTER" spacing="14.0"
              prefWidth="720.0" maxWidth="720.0" maxHeight="500.0"
              style="-fx-background-color: rgba(13, 20, 36, 0.52); -fx-background-radius: 18px; -fx-padding: 20px 24px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 35, 0.4, 0, 10); -fx-border-color: rgba(56, 189, 248, 0.5); -fx-border-width: 2px; -fx-border-radius: 18px;">

            <!-- Header Popup: Tiêu đề & Nút X đóng -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="BATTLE DETAILS"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Label fx:id="detailRoomTimeLabel"
                           text="ROOM #01 • 60S • 03/10/2026 15:30"
                           style="-fx-font-family: 'Kenney Future Narrow', 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                </VBox>

                <!-- Nút X đóng popup -->
                <Button text="✕"
                        prefWidth="34.0" prefHeight="34.0"
                        style="-fx-background-color: rgba(30, 41, 59, 0.6); -fx-text-fill: #94a3b8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 17px; -fx-cursor: hand; -fx-border-color: rgba(148, 163, 184, 0.3); -fx-border-radius: 17px;"
                        onAction="#handleCloseDetail"/>
            </HBox>

            <!-- Banner người chiến thắng hoặc hòa -->
            <HBox fx:id="winnerBanner" alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: rgba(234, 179, 8, 0.15); -fx-padding: 8px 16px; -fx-background-radius: 10px; -fx-border-color: rgba(234, 179, 8, 0.4); -fx-border-radius: 10px; -fx-border-width: 1px;">
                <Label text="👑" style="-fx-font-size: 16px;"/>
                <Label fx:id="winnerTextLabel"
                       text="VICTOR: PlayerOne"
                       style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #fbbf24; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Bảng danh sách tất cả người chơi trong trận đấu -->
            <VBox style="-fx-background-color: rgba(10, 16, 30, 0.45); -fx-background-radius: 12px; -fx-border-color: rgba(56, 189, 248, 0.25); -fx-border-width: 1px; -fx-border-radius: 12px;"
                  VBox.vgrow="ALWAYS">

                <!-- Header danh sách người chơi -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(15, 23, 42, 0.55); -fx-padding: 9px 16px; -fx-background-radius: 11px 11px 0 0; -fx-border-color: rgba(56, 189, 248, 0.2); -fx-border-width: 0 0 1px 0;">
                    <Label text="RANK" prefWidth="80.0" alignment="CENTER_LEFT"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                    <Label text="OPERATOR" prefWidth="250.0" alignment="CENTER_LEFT"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                    <Label text="KILLS" prefWidth="100.0" alignment="CENTER_RIGHT"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                    <Label text="HITS" prefWidth="110.0" alignment="CENTER_RIGHT"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                    <Label text="POINTS" prefWidth="110.0" alignment="CENTER_RIGHT"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                </HBox>

                <ListView fx:id="participantListView"
                          VBox.vgrow="ALWAYS"
                          prefHeight="190.0"
                          style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 2px;"/>
            </VBox>

            <!-- Nút đóng dưới cùng -->
            <HBox alignment="CENTER">
                <Button text="CLOSE"
                        prefWidth="160.0" prefHeight="40.0"
                        styleClass="btn-primary"
                        onAction="#handleCloseDetail"/>
            </HBox>
        </VBox>
    </StackPane>

</StackPane>
