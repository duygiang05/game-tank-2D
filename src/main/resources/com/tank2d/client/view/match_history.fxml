<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<StackPane fx:id="rootStackPane" xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.tank2d.client.controller.MatchHistoryController"
           stylesheets="@match-history-theme.css" prefWidth="1000" prefHeight="750"
           styleClass="history-root">
  <BorderPane fx:id="mainContentPane" styleClass="history-main">
    <top>
      <HBox alignment="CENTER_LEFT" spacing="18" styleClass="history-top">
        <BorderPane.margin><Insets top="22" right="34" left="34" bottom="14"/></BorderPane.margin>
        <ImageView fitWidth="90" fitHeight="70" preserveRatio="true"><image><Image url="@tank-logo_1.png"/></image></ImageView>
        <VBox spacing="5" alignment="CENTER_LEFT">
          <Label text="TANK 2D ONLINE" styleClass="history-brand"/>
          <Label text="LỊCH SỬ THI ĐẤU CÁ NHÂN" styleClass="history-title"/>
          <Label text="MATCH RECORDS  /  BATTLE ARCHIVE" styleClass="history-subtitle"/>
        </VBox>
      </HBox>
    </top>
    <center>
      <VBox spacing="9" styleClass="history-panel">
        <BorderPane.margin><Insets left="34" right="34"/></BorderPane.margin>
        <HBox alignment="CENTER_LEFT" styleClass="history-header">
          <Label text="KẾT QUẢ / HẠNG" minWidth="143" prefWidth="143"/>
          <Label text="PHÒNG ĐẤU" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
          <Label text="THỜI GIAN" minWidth="145" prefWidth="145"/>
          <Label text="KILLS / TRÚNG" minWidth="112" prefWidth="112" alignment="CENTER_RIGHT"/>
          <Label text="ĐIỂM NHẬN" minWidth="90" prefWidth="90" alignment="CENTER_RIGHT"/>
        </HBox>
        <ListView fx:id="matchHistoryListView" prefHeight="320" VBox.vgrow="ALWAYS"
                  styleClass="history-list"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
          <Label fx:id="statusLabel" text="Đang tải lịch sử thi đấu..." styleClass="history-status"/>
          <HBox HBox.hgrow="ALWAYS"/>
          <Label text="Chọn một trận để xem chi tiết" styleClass="history-hint"/>
        </HBox>
      </VBox>
    </center>
    <bottom>
      <HBox alignment="CENTER">
        <BorderPane.margin><Insets top="14" bottom="22"/></BorderPane.margin>
        <Button fx:id="backButton" text="← QUAY LẠI SẢNH" prefWidth="225" prefHeight="67"
                styleClass="history-button-blue" onAction="#handleBack"/>
      </HBox>
    </bottom>
  </BorderPane>
  <StackPane fx:id="detailOverlay" visible="false" styleClass="history-overlay"
             onMouseClicked="#handleOverlayClicked">
    <VBox fx:id="detailCard" spacing="13" maxWidth="760" maxHeight="540" styleClass="history-detail-card">
      <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
          <Label text="CHI TIẾT TRẬN ĐẤU" styleClass="history-detail-heading"/>
          <Label fx:id="detailRoomTimeLabel" text="Phòng đấu • Thời gian" styleClass="history-detail-subtitle"/>
        </VBox>
        <Button text="✕" styleClass="history-close" onAction="#handleCloseDetail"/>
      </HBox>
      <HBox fx:id="winnerBanner" alignment="CENTER_LEFT" spacing="10" styleClass="history-winner">
        <Label text="★" styleClass="history-banner-icon"/>
        <Label fx:id="winnerTextLabel" text="Người chiến thắng" styleClass="history-banner-text"/>
      </HBox>
      <VBox spacing="6" VBox.vgrow="ALWAYS" styleClass="history-participants-panel">
        <HBox alignment="CENTER_LEFT" styleClass="history-participants-header">
          <Label text="HẠNG" minWidth="62" prefWidth="62"/>
          <Label text="NGƯỜI CHƠI" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
          <Label text="KILLS" minWidth="73" prefWidth="73" alignment="CENTER_RIGHT"/>
          <Label text="TRÚNG ĐÍCH" minWidth="81" prefWidth="81" alignment="CENTER_RIGHT"/>
          <Label text="ĐIỂM NHẬN" minWidth="96" prefWidth="96" alignment="CENTER_RIGHT"/>
        </HBox>
        <ListView fx:id="participantListView" VBox.vgrow="ALWAYS" prefHeight="225"
                  styleClass="history-participant-list"/>
      </VBox>
      <HBox alignment="CENTER">
        <Button text="ĐÓNG CHI TIẾT" prefWidth="190" prefHeight="60"
                styleClass="history-button-red" onAction="#handleCloseDetail"/>
      </HBox>
    </VBox>
  </StackPane>
</StackPane>
