<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tank2d.client.controller.LeaderboardController"
            stylesheets="@lobby.css"
            prefWidth="800.0"
            prefHeight="600.0"
            style="-fx-background-color: #f1f5f9;">

    <!-- ============================================== -->
    <!-- TOP: LOGO & TIÊU ĐỀ BẢNG XẾP HẠNG              -->
    <!-- ============================================== -->
    <top>
        <VBox alignment="CENTER" spacing="4.0">
            <padding>
                <Insets top="14.0" bottom="8.0"/>
            </padding>

            <ImageView fitWidth="50.0" fitHeight="32.0" preserveRatio="true">
                <image>
                    <Image url="@tank-logo_1.png"/>
                </image>
            </ImageView>

            <Label text="TANK 2D ONLINE"
                   style="-fx-text-fill: #1d4ed8; -fx-font-size: 19px; -fx-font-weight: bold;"/>

            <Label text="🏆 BẢNG VINH DANH CAO THỦ"
                   style="-fx-text-fill: #0f172a; -fx-font-size: 17px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- ============================================== -->
    <!-- CENTER: BẢNG XẾP HẠNG DẠNG THẺ CAO CẤP         -->
    <!-- ============================================== -->
    <center>
        <VBox spacing="6.0">
            <padding>
                <Insets top="2.0" right="45.0" bottom="4.0" left="45.0"/>
            </padding>

            <VBox style="-fx-background-color: white; -fx-background-radius: 14px; -fx-border-color: #e2e8f0; -fx-border-width: 1px; -fx-border-radius: 14px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 14, 0, 0, 3);"
                  VBox.vgrow="ALWAYS">

                <!-- Thanh Header chia 5 cột chuẩn xác: 80 + 200 + 120 + 110 + 110 = 620px -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-background-color: #f8fafc; -fx-padding: 10px 16px; -fx-background-radius: 13px 13px 0 0; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1px 0;">

                    <Label text="HẠNG" prefWidth="80.0" alignment="CENTER_LEFT"
                           style="-fx-font-size: 12.5px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>

                    <Label text="TÊN NGƯỜI CHƠI" prefWidth="200.0" alignment="CENTER_LEFT"
                           style="-fx-font-size: 12.5px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>

                    <Label text="POINTS" prefWidth="120.0" alignment="CENTER_RIGHT"
                           style="-fx-font-size: 12.5px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>

                    <Label text="KILLS" prefWidth="120.0" alignment="CENTER_RIGHT"
                           style="-fx-font-size: 12.5px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>

                    <Label text="WINS" prefWidth="100.0" alignment="CENTER_RIGHT"
                           style="-fx-font-size: 12.5px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                </HBox>

                <!-- ListView: Triệt tiêu hoàn toàn scrollbar ngang -->
                <ListView fx:id="leaderboardListView"
                          VBox.vgrow="ALWAYS"
                          prefHeight="310.0"
                          style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 4px;"/>
            </VBox>

            <Label fx:id="statusLabel"
                   text="Đang tải bảng xếp hạng..."
                   style="-fx-text-fill: #64748b; -fx-font-size: 12.5px; -fx-padding: 0 4px;"/>
        </VBox>
    </center>

    <!-- ============================================== -->
    <!-- BOTTOM: NÚT QUAY LẠI LOBBY                     -->
    <!-- ============================================== -->
    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="4.0" bottom="18.0"/>
            </padding>

            <Button fx:id="backButton"
                    text="← Quay lại"
                    prefWidth="190.0"
                    prefHeight="40.0"
                    style="-fx-background-color: white; -fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 13.5px; -fx-border-color: #cbd5e1; -fx-border-width: 1.5px; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-cursor: hand;"
                    onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>