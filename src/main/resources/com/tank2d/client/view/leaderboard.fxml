<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tank2d.client.controller.LeaderboardController"
            stylesheets="@lobby.css"
            styleClass="leaderboard-root"
            prefWidth="960.0"
            prefHeight="600.0">

    <!-- ============================================== -->
    <!-- TOP: LOGO & TIÊU ĐỀ BẢNG XẾP HẠNG              -->
    <!-- ============================================== -->
    <top>
        <VBox alignment="CENTER" spacing="4.0">
            <padding>
                <Insets top="14.0" bottom="8.0"/>
            </padding>

            <ImageView fitWidth="50.0" fitHeight="34.0" preserveRatio="true">
                <image>
                    <Image url="@tank-logo_1.png"/>
                </image>
            </ImageView>

            <Label text="TANK 2D ONLINE"
                   style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #38bdf8; -fx-font-size: 18px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(56, 189, 248, 0.5), 10, 0.3, 0, 0);"/>

            <Label text="🏆 TOP OPERATORS RANKINGS"
                   style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #fbbf24; -fx-font-size: 16px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- ============================================== -->
    <!-- CENTER: BẢNG XẾP HẠNG DẠNG THẺ CAO CẤP         -->
    <!-- ============================================== -->
    <center>
        <VBox spacing="6.0">
            <padding>
                <Insets top="2.0" right="45.0" bottom="4.0" left="45.0"/>
            </padding>

            <VBox style="-fx-background-color: rgba(13, 20, 36, 0.42); -fx-background-radius: 14px; -fx-border-color: rgba(56, 189, 248, 0.4); -fx-border-width: 2px; -fx-border-radius: 14px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.65), 22, 0.35, 0, 6);"
                  VBox.vgrow="ALWAYS">

                <!-- Thanh Header chia 5 cột gọn gàng: 90 + 280 + 130 + 110 + 110 = 720px -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(15, 23, 42, 0.50); -fx-padding: 10px 18px; -fx-background-radius: 12px 12px 0 0; -fx-border-color: rgba(56, 189, 248, 0.25); -fx-border-width: 0 0 1.5px 0;">

                    <Label text="RANK" prefWidth="90.0" alignment="CENTER_LEFT"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>

                    <Label text="OPERATOR" prefWidth="280.0" alignment="CENTER_LEFT"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>

                    <Label text="POINTS" prefWidth="130.0" alignment="CENTER_RIGHT"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>

                    <Label text="KILLS" prefWidth="110.0" alignment="CENTER_RIGHT"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>

                    <Label text="WINS" prefWidth="110.0" alignment="CENTER_RIGHT"
                           style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                </HBox>

                <!-- ListView: Triệt tiêu hoàn toàn scrollbar ngang -->
                <ListView fx:id="leaderboardListView"
                          VBox.vgrow="ALWAYS"
                          prefHeight="310.0"
                          style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 4px;"/>
            </VBox>

            <Label fx:id="statusLabel"
                   text="LOADING RANKINGS..."
                   style="-fx-font-family: 'Kenney Future', 'Segoe UI', sans-serif; -fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-padding: 0 4px;"/>
        </VBox>
    </center>

    <!-- ============================================== -->
    <!-- BOTTOM: NÚT QUAY LẠI LOBBY                     -->
    <!-- ============================================== -->
    <bottom>
        <HBox alignment="CENTER">
            <padding>
                <Insets top="4.0" bottom="18.0"/>
            </padding>

            <Button fx:id="backButton"
                    text="← BACK TO LOBBY"
                    prefWidth="220.0"
                    prefHeight="44.0"
                    styleClass="btn-primary"
                    onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>