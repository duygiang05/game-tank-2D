# ==============================================================================
# CẤU HÌNH MẠNG LÕI (SERVER NETWORK CONFIGURATION)
# ==============================================================================
# Địa chỉ IP của máy chủ Server (127.0.0.1 là localhost chạy trên máy cá nhân)
SERVER_HOST=127.0.0.1

# Cổng cổng TCP Socket mà Server sẽ mở để lắng nghe các Client kết nối tới
SERVER_PORT=8888

# ==============================================================================
# CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL TRÊN XAMPP
# ==============================================================================
# Địa chỉ máy chủ MySQL (mặc định XAMPP là localhost)
DB_HOST=localhost

# Cổng mặc định của dịch vụ MySQL trong XAMPP
DB_PORT=3306

# Tên Database vừa tạo trong phpMyAdmin
DB_NAME=tank2d_db

# Tài khoản mặc định của MySQL XAMPP (root)
DB_USER=root

# Mật khẩu mặc định của MySQL XAMPP (để trống)
DB_PASS=

# ==============================================================================
# CẤU HÌNH CONNECTION POOL (HIKARICP)
# ==============================================================================
# Số lượng kết nối tối đa được duy trì đồng thời tới CSDL để tái sử dụng
DB_MAX_POOL_SIZE=10